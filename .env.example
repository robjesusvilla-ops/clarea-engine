# Copia este archivo como .env y completa solo lo que uses.
# .env no se sube a GitHub.

# API de Meta (clarea fetch)
META_PAGE_TOKEN=
META_PAGE_ID=

# Claude (clarea analyze --ai)
ANTHROPIC_API_KEY=

# Correo (clarea client send / botón "Enviar por correo")
CLAREA_SMTP_HOST=
CLAREA_SMTP_PORT=587
CLAREA_SMTP_USER=
CLAREA_SMTP_PASSWORD=
CLAREA_SMTP_FROM=

# App web (clarea web)
CLAREA_WEB_USER=
CLAREA_WEB_PASSWORD=
CLAREA_DATA_DIR=clarea_data
